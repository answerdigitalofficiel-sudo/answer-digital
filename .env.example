# Copier ce fichier en .env.local pour le développement local.
# Sur Vercel : Settings → Environment Variables (mêmes noms).
# Ne jamais versionner .env.local.

# URL publique du site (SEO). Remplacer par le domaine une fois acheté.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — clés PUBLIQUES par conception : la sécurité repose sur les règles RLS de la base.
# La clé « service_role » ne doit JAMAIS être utilisée ni exposée dans ce projet.
NEXT_PUBLIC_SUPABASE_URL=https://dvelieaemwqmrnebdtib.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
